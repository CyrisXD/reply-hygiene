{
  "manifest_version": 3,
  "name": "Reply Hygiene",
  "version": "1.0.1",
  "minimum_chrome_version": "111",
  "description": "Blocks the accounts on the blockedforaireply.com list from a pinned tab, within X's rate limits. Undoes blocks after appeals.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://x.com/*", "https://blockedforaireply.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html", "default_title": "Reply Hygiene",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    { "matches": ["https://x.com/*"], "js": ["hook.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://x.com/*"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
